OSM_REBUILD_ENVIRONMENT=development
OSM_REBUILD_SECRET_KEY=replace-with-a-random-secret-at-least-fifty-characters-long
OSM_REBUILD_ALLOWED_HOSTS=localhost,127.0.0.1,tenant-a.localhost,tenant-b.localhost
OSM_REBUILD_DB_NAME=optics_rebuild_dev
OSM_REBUILD_DB_USER=optics_rebuild_owner
OSM_REBUILD_DB_PASSWORD=replace-with-a-new-local-password
OSM_REBUILD_DB_HOST=127.0.0.1
OSM_REBUILD_DB_PORT=55432
OSM_REBUILD_RUNTIME_DB_PASSWORD=replace-with-a-separate-runtime-password

# Enable smtp only after configuring the host, sender and a scheduled mail worker.
OSM_REBUILD_INVITE_DELIVERY=manual
OSM_REBUILD_SMTP_HOST=
OSM_REBUILD_SMTP_PORT=587
OSM_REBUILD_SMTP_USER=
OSM_REBUILD_SMTP_PASSWORD=
OSM_REBUILD_SMTP_TLS=true
OSM_REBUILD_SMTP_FROM=
